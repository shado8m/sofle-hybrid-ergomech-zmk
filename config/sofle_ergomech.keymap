#define ZMK_POINTING_DEFAULT_SCRL_VAL 300

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC         &kp F1    &kp F2    &kp F3     &kp F4  &kp F5     &kp F6           &kp F7     &kp F8        &kp F9          &kp F10         &kp DEL
&kp TAB         &kp Q     &kp W     &kp E      &kp R   &kp T      &kp Y            &kp U      &kp I         &kp O           &kp P           &kp NON_US_BACKSLASH
&kp ENTER       &kp A     &kp S     &kp D      &kp F   &kp G      &kp H            &kp J      &kp K         &kp L           &kp AMPS        &kp RET
&kp LEFT_SHIFT  &kp Z     &kp X     &kp C      &kp V   &kp B      &kp N            &kp M      &kp AT        &kp HASH        &kp DOLLAR      &kp RIGHT_SHIFT
&kp C_AC_ZOOM   &kp LGUI  &kp LALT  &kp LCTRL  &mo 1   &kp SPACE  &kp SPACE        &mo 2      &kp RCTRL     &kp RALT        &kp RGUI
                                                                  &kp PRINTSCREEN  &kp RIGHT  &kp UP_ARROW  &kp LEFT_ARROW  &kp DOWN_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            label = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp PRINTSCREEN  &kp GRAVE    &kp UNDER       &kp TILDE          &trans  &trans  &trans  &trans   &trans       &kp K_CALC      &kp PRINTSCREEN  &kp BACKSPACE
&kp QUESTION     &kp SLASH    &kp PIPE        &kp BACKSLASH      &trans  &trans  &trans  &trans   &trans       &trans          &trans           &trans
&kp EXCLAMATION  &kp SEMI     &kp COLON       &kp DOUBLE_QUOTES  &trans  &trans  &trans  &trans   &trans       &trans          &trans           &trans
&kp CAPS         &kp COMMA    &kp PERIOD      &kp SINGLE_QUOTE   &trans  &trans  &trans  &trans   &trans       &trans          &trans           &trans
&kp K_MUTE       &bootloader  &studio_unlock  &trans             &trans  &trans  &trans  &trans   &trans       &studio_unlock  &bootloader
                                                                                 &kp A   &kp END  &kp PAGE_UP  &kp HOME        &kp PAGE_DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            label = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans            &trans      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CARET     &kp BACKSPACE
&trans      &trans        &trans          &trans        &trans        &trans        &trans            &trans      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp ASTERISK  &kp KP_DIVIDE
&caps_word  &trans        &trans          &trans        &trans        &trans        &trans            &trans      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp MINUS     &kp EQUAL
&trans      &kp K_UNDO    &kp K_CUT       &kp K_COPY    &kp K_PASTE   &trans        &trans            &trans      &kp LESS_THAN         &kp GREATER_THAN       &kp PLUS      &kp KP_DOT
&kp K_MUTE  &bootloader   &studio_unlock  &trans        &trans        &trans        &trans            &trans      &trans                &studio_unlock         &bootloader
                                                                                    &kp K_PLAY_PAUSE  &kp C_NEXT  &kp C                 &kp C_PREVIOUS         &kp E
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &none   &none   &none   &none   &none   &none
&ext_power EP_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &none   &none   &none   &none   &none   &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &rgb_ug RGB_TOG  &none   &none   &none   &none   &none   &none
&none              &none            &none            &none            &none            &none            &none   &none   &none   &none   &none   &none
&trans             &none            &none            &none            &none            &none            &none   &none   &none   &none   &none
                                                                                                        &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };
    };
};
